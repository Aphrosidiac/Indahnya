# Read directly (server/db, drizzle-kit).
DATABASE_URL=postgres://localhost:5432/indahnya

# Everything else is Nuxt runtime config: NUXT_ + the config path in
# UPPER_SNAKE. These are read when the server STARTS, not when it is built.
NUXT_PUBLIC_SITE_URL=https://indahnya.my

NUXT_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
NUXT_S3_REGION=auto
# Public bucket: served copies only, behind the custom domain below.
NUXT_S3_BUCKET=indahnya-media
# Private bucket: originals + hidden media. Must NOT have a public domain.
NUXT_S3_PRIVATE_BUCKET=indahnya-private
NUXT_S3_ACCESS_KEY_ID=
NUXT_S3_SECRET_ACCESS_KEY=
NUXT_S3_PUBLIC_BASE=https://media.indahnya.my

NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_STRIPE_PRICE_STD=
NUXT_STRIPE_PRICE_FULL=

NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# Required in production: without it sign-in links are refused, never logged.
NUXT_SMTP_URL=
NUXT_SMTP_FROM=Indahnya <hello@indahnya.my>
