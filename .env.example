# In production this lives in /etc/indahnya/env (see ecosystem.config.cjs and
# docs/deployment.md); locally in .env. The server refuses to start in production
# when a required value is missing (server/plugins/00.config-check.ts).

# Read directly (server/db, drizzle-kit, scripts/migrate.mjs).
DATABASE_URL=postgres://localhost:5432/indahnya
# Optional: connections per process (default 10).
# DB_POOL_MAX=10

# Everything else is Nuxt runtime config: NUXT_ + the config path in
# UPPER_SNAKE. These are read when the server STARTS, not when it is built.
NUXT_PUBLIC_SITE_URL=https://indahnya.my

NUXT_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
NUXT_S3_REGION=auto
# Public bucket: served copies only, behind the custom domain below.
NUXT_S3_BUCKET=indahnya-media
# Private bucket: originals + hidden media. Must NOT have a public domain.
NUXT_S3_PRIVATE_BUCKET=indahnya-private
NUXT_S3_ACCESS_KEY_ID=
NUXT_S3_SECRET_ACCESS_KEY=
NUXT_S3_PUBLIC_BASE=https://media.indahnya.my

# CHIP Collect (portal.chip-in.asia → Developers): a test or live secret key, the Brand ID,
# and the account webhook's public key (node deploy/chip.mjs creates the webhook and fills it in)
NUXT_CHIP_SECRET_KEY=
NUXT_CHIP_BRAND_ID=
NUXT_CHIP_WEBHOOK_PUBLIC_KEY=

NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# Required in production: without it sign-in links are refused, never logged.
NUXT_SMTP_URL=
NUXT_SMTP_FROM=Indahnya <hello@indahnya.my>

# Who runs the service, on /privasi and /terma. Required in production.
NUXT_PUBLIC_LEGAL_NAME=
NUXT_PUBLIC_LEGAL_REG=
NUXT_PUBLIC_LEGAL_ADDRESS=

# Where alerts go (refunds needed, jobs given up, mail failures). Strongly recommended.
NUXT_ALERT_EMAIL=

# Optional: drop hidden/deleted media from Cloudflare's edge at once
# (an API token with Zone → Cache Purge on the indahnya.my zone).
NUXT_CLOUDFLARE_ZONE_ID=
NUXT_CLOUDFLARE_API_TOKEN=

# Process roles (set per process in ecosystem.config.cjs, not here):
#   WORKER=0                      web only, never processes media
#   WORKER_PHOTO_CONCURRENCY=2    photos at once in a worker
#   WORKER_VIDEO_CONCURRENCY=1    video encodes at once in a worker
#   FFMPEG_THREADS=2              threads per encode
